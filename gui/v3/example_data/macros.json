  {
   "key": "shots",
   "needs": [],
   "name": {
    "ko": "예시_화면 사진 3장 찍기",
    "en": "Example - Take 3 screenshots"
   },
   "description": {
    "ko": "3초마다 화면을 한 장씩, 모두 3장 찍어 기록 폴더(logs/snapshots)에 저장합니다. 마우스·키보드는 쓰지 않습니다.",
    "en": "Takes a screenshot every 3 seconds, 3 in total, and saves them in the log folder (logs/snapshots). It does not use the mouse or keyboard."
   },
   "steps": [
    {
     "type": "repeat",
     "times": 3,
     "steps": [
      {
       "type": "snapshot",
       "name": "example"
      },
      {
       "type": "delay",
       "seconds": 3
      }
     ]
    }
   ]
  },

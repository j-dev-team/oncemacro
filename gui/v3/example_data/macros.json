  {
   "key": "hwp",
   "needs": [
    "excel",
    "hwp"
   ],
   "name": {
    "ko": "예시_한글 재직증명서 채우기",
    "en": "Example - Fill HWP certificates"
   },
   "description": {
    "ko": "명단 엑셀의 앞 3명으로 한글 재직증명서 서식의 누름틀을 채워 3개 파일로 예시/출력 폴더에 저장합니다. 엑셀과 한글이 있어야 합니다.",
    "en": "Fills the fields of an HWP certificate form with the first 3 people from a roster in Excel and saves 3 files in the example output folder. Needs Excel and Hancom Office (HWP)."
   },
   "steps": [
    {
     "type": "excel",
     "action": "open",
     "path": "@DATA@\\자료\\명단.xlsx"
    },
    {
     "type": "set",
     "var": "행",
     "value": 2
    },
    {
     "type": "repeat",
     "times": 3,
     "steps": [
      {
       "type": "excel",
       "action": "read",
       "sheet": "명단",
       "cell": "A{행}",
       "var": "이름"
      },
      {
       "type": "excel",
       "action": "read",
       "sheet": "명단",
       "cell": "B{행}",
       "var": "부서"
      },
      {
       "type": "excel",
       "action": "read",
       "sheet": "명단",
       "cell": "C{행}",
       "var": "직위"
      },
      {
       "type": "excel",
       "action": "read",
       "sheet": "명단",
       "cell": "D{행}",
       "var": "입사일"
      },
      {
       "type": "hwp",
       "action": "open",
       "path": "@DATA@\\자료\\서식_재직증명서.hwp"
      },
      {
       "type": "hwp",
       "action": "fill_field",
       "name": "이름",
       "text": "{이름}"
      },
      {
       "type": "hwp",
       "action": "fill_field",
       "name": "부서",
       "text": "{부서}"
      },
      {
       "type": "hwp",
       "action": "fill_field",
       "name": "직위",
       "text": "{직위}"
      },
      {
       "type": "hwp",
       "action": "fill_field",
       "name": "입사일",
       "text": "{입사일}"
      },
      {
       "type": "hwp",
       "action": "save_as",
       "path": "@DATA@\\출력\\재직증명서_{이름}.hwp"
      },
      {
       "type": "hwp",
       "action": "close"
      },
      {
       "type": "set",
       "var": "행",
       "add": 1
      }
     ]
    },
    {
     "type": "excel",
     "action": "close"
    }
   ],
   "langs": [
    "ko"
   ]
  }
 ]

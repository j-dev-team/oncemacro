       "sheet": "Sales",
       "cell": "A",
       "var": "last"
      },
      {
       "type": "set",
       "var": "row",
       "value": 2
      },
      {
       "type": "repeat",
       "while": {
        "var": "row",
        "le": {
         "var": "last"
        }
       },
       "steps": [
        {
         "type": "excel",
         "action": "open",
         "path": "@DATA@\\data\\branch_boston.xlsx"
        },
        {
         "type": "excel",
         "action": "read",
         "sheet": "Sales",
         "cell": "A{row}",
         "var": "date"
        },
        {
         "type": "excel",
         "action": "read",
         "sheet": "Sales",
         "cell": "B{row}",
         "var": "item"

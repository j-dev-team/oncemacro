         "cell": "D{out}",
         "value": "{qty}"
        },
        {
         "type": "excel",
         "action": "write",
         "sheet": "Collected",
         "cell": "E{out}",
         "value": "{amount}"
        },
        {
         "type": "set",
         "var": "out",
         "add": 1
        },
        {
         "type": "set",
         "var": "row",
         "add": 1
        }

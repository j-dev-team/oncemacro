         "type": "excel",
         "action": "read",
         "sheet": "Sales",
         "cell": "D{row}",
         "var": "amount"
        },
        {
         "type": "excel",
         "action": "open",
         "path": "@DATA@\\data\\summary_template.xlsx"
        },
        {
         "type": "excel",
         "action": "write",
         "sheet": "Collected",
         "cell": "A{out}",
         "value": "{branch}"
        },
        {
         "type": "excel",
         "action": "write",
         "sheet": "Collected",
         "cell": "B{out}",
         "value": "{date}"
        },
        {
         "type": "excel",
         "action": "write",
         "sheet": "Collected",
         "cell": "C{out}",
         "value": "{item}"
        },
        {
         "type": "excel",
         "action": "write",
